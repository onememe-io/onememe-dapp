# Deployer private key for BNB Smart Chain. Never commit the filled-in .env.
PRIVATE_KEY=

# Optional: a separate key for BSC testnet (chain 97). Falls back to PRIVATE_KEY.
TESTNET_PRIVATE_KEY=

# BNB Smart Chain RPC endpoints. The defaults are public Binance endpoints;
# override them with your own provider for reliability.
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org

# Platform fee receiver. Defaults to the deployer if left blank.
FEE_RECEIVER=

# BscScan API key, used only when verifying contracts.
BSCSCAN_API_KEY=

# Fork testing: point at a BSC RPC and set the chain id (56 mainnet, 97 testnet).
FORK_RPC=
FORK_CHAINID=56
